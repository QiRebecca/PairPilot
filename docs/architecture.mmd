flowchart LR
    PUB["Unauthenticated website<br/>Landing · Sign up · Sign in<br/>Privacy · Terms"]
    DEMO["Synthetic demo namespace<br/>Qi · Alice · Maya · Lena<br/>never enters production Explore"]
    AUTH["Firebase Authentication<br/>Email/password · verification<br/>reset · session restoration"]
    APP["Authenticated PairPilot App<br/>/app/agent · requests · explore<br/>decisions · rooms · network · memory"]
    API["Cloud Run auth middleware<br/>verify Firebase ID token + revocation<br/>derive UID · owner/member checks"]
    AGENT["User-scoped Personal Agent runtime<br/>load arbitrary agent_id + owner policy<br/>two bounded ADK/Gemini turns"]
    TASK["Task Workspace Registry<br/>owner-scoped conversations<br/>decisions · quotas · leases"]
    POSTS["Public Intent Registry<br/>human-approved projection only<br/>OPEN · PAUSED · MATCHED · CLOSED"]
    PRIVATE["Private Intent + Memory stores<br/>raw goal · Agent-only boundaries<br/>owner UID never sent to peers"]
    BUS["Pub/Sub async orchestration<br/>OIDC push · intent.published.v2<br/>bounded retry · idempotent delivery"]
    A2A["Intent-scoped Agent communication<br/>principal Agent + internal owner UID<br/>source/target task + intent provenance"]
    COMMIT["Proposal · Hold · Dual Approval<br/>Agent A + Agent B accept version N<br/>Human A + Human B approve hashes"]
    ROOM["Participant-scoped rooms<br/>AGENTS_ONLY before match<br/>SHARED_ROOM after atomic commit"]
    SOCIAL["Independent owner networks<br/>relationship + scoped memory<br/>block · report · leave · delete"]
    FS[("Firestore authoritative state<br/>server-only access<br/>client rules deny by default")]

    PUB --> AUTH
    PUB --> DEMO
    AUTH -->|"fresh Firebase ID token"| APP
    APP --> API
    API --> TASK
    API --> POSTS
    API --> PRIVATE
    POSTS -->|"publish event"| BUS
    BUS --> AGENT
    AGENT <-->|"task-scoped A2A"| A2A
    AGENT --> COMMIT
    COMMIT -->|"two current human approvals"| FS
    FS --> POSTS
    FS --> ROOM
    FS --> SOCIAL
    TASK --> FS
    PRIVATE --> AGENT
    DEMO -. isolated .-> FS
